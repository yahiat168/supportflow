# Copy to .env and fill in MODEL_API_KEY and EVALS_ADMIN_TOKEN.
# Keep comments on their OWN lines: text after a value becomes part of the value.

# ---------- runtime ----------
# development | test | production (production disables /dev and /evals routes)
APP_ENV=development
# gemini | openai | offline  (offline = deterministic, key-free mode for CI/tests)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# ---------- model ----------
# Your key (Gemini, OpenAI, or a LiteLLM proxy key)
MODEL_API_KEY=
# For the Sprints LiteLLM proxy use:
#   MODEL_BASE_URL=https://management.sprints.ai/litellm
#   MODEL_NAME=gemini/gemini-3.6-flash
#   EMBEDDING_MODEL=gemini/gemini-embedding-001
MODEL_BASE_URL=https://management.sprints.ai/litellm
MODEL_NAME=gemini/gemini-3.6-flash
EMBEDDING_MODEL=gemini/gemini-embedding-001
STRUCTURED_OUTPUT_METHOD=function_calling
MODEL_TIMEOUT_S=30
MODEL_MAX_RETRIES=6

# ---------- rate limits (shared / free-tier keys) ----------
# Seconds to wait after "429 Too Many Requests" before each retry
RATE_LIMIT_WAITS=5,10,20,40,60,60
CHAT_RATE_LIMIT_WAITS=3,8,15
# Pause between documents during ingestion, and between eval cases
INGEST_DELAY_S=3
EVAL_CASE_DELAY_S=4

# ---------- vector DB ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cloudbox_kb
AUTO_INGEST=true

# ---------- relational DB ----------
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow

# ---------- monitoring (free account at cloud.langfuse.com) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- frontend ----------
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# ---------- protected dev routes: a password you choose ----------
EVALS_ADMIN_TOKEN=change-me

# ---------- guardrails / budgets ----------
RETRIEVAL_TOP_K=5
# Calibrate with: python scripts/check_setup.py --kb   (then uncomment)
# MIN_RELEVANCE_SCORE=0.55
MAX_MODEL_CALLS=6
MAX_CRITIC_REVISIONS=1
TOOL_TIMEOUT_S=5
TOOL_MAX_RETRIES=1
GRAPH_RECURSION_LIMIT=25
# operational | previews_degraded | sync_outage
STATUS_SCENARIO=operational

# ---------- alert thresholds (GET /metrics/summary) ----------
ALERT_LATENCY_MS=15000
ALERT_ERROR_RATE=0.10
ALERT_ESCALATION_RATE=0.40
ALERT_NEGATIVE_FEEDBACK_RATE=0.30
